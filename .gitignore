# --- secrets -------------------------------------------------------------
.env
.env.local
frontend/.env.local

# --- data ----------------------------------------------------------------
# Datasets, imagery and derived artefacts live on Drive, not in git.
# data/dataset_summary.json IS tracked: it is the provenance record for how the
# training set was built (class counts, split strategy, detected XML tags).
data/*
!data/.gitkeep
!data/dataset_summary.json

# --- model weights -------------------------------------------------------
# The two trained models ARE tracked: 5.6 MB + 3.3 MB, small enough for git and
# they make the repository runnable without a 9-hour training run.
weights/*
!weights/classes.txt
!weights/best.pt
!weights/crop_classifier.pt
# the camera constants fitted on held-out sequences travel with the models
!weights/calibration.json
# pretrained checkpoints downloaded by ultralytics at runtime, and export formats
yolo*.pt
*.onnx
*.engine
runs/

# --- python --------------------------------------------------------------
__pycache__/
*.py[cod]
.Python
venv/
.venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# --- node / next ---------------------------------------------------------
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/tsconfig.tsbuildinfo
npm-debug.log*
yarn-error.log*

# --- build artefacts -----------------------------------------------------
repo_for_drive.zip
*.zip
*.tar.gz

# --- superseded / not needed to run the project --------------------------
# Kept on disk for reference, kept out of the repo so a fresh clone contains
# only what is required to reproduce the pipeline end to end.

# Replaced by geometric association, which solves the same problem better using
# data already present (see README, "How it works").
scripts/09b_depth_project.py

# Generated the synthetic placeholder frames used before real ARTSv2 sequences
# were available. Phase F of the notebook supersedes it.
scripts/make_demo_sequence.py

# Seeds fake map pins. Real sequences are uploaded by scripts/07_batch_evaluate.py.
scripts/05_seed_demo_signs.sql

# Regenerated by `next dev` / `next build`.
frontend/next-env.d.ts

# --- editors / os --------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.log
