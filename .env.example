# Copy to .env and fill in. .env is gitignored -- never commit the service key.

# Supabase (Project Settings -> API)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_ANON_KEY=your_anon_key

# Local YOLO weights (copy best.pt from Drive after Colab training)
WEIGHTS_PATH=weights/best.pt

# Second-stage crop classifier. Set to "none" to disable it.
CLS_WEIGHTS=weights/crop_classifier.pt
CLS_MIN_CONF=0.8

# Detection
CONF=0.25
TRACKER=botsort.yaml

# CORS origin for the Next.js frontend
FRONTEND_ORIGIN=http://localhost:3000

# Folder of frames the pipeline processes
SEQUENCE_DIR=data/demo_sequence

# Demo escape hatch. When 1, detections with no GPS get a placeholder
# coordinate tagged gps_source='synthetic_demo' (grey pin, red badge in the UI).
# Leave at 0 for anything you intend to show or measure.
ALLOW_SYNTHETIC_GPS=0
